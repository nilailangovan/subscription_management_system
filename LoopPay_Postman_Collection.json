{
  "info": {
    "_postman_id": "looppay-api-collection",
    "name": "LoopPay — Subscription Management API",
    "description": "Postman Collection for testing LoopPay Auth & Admin APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public Auth APIs",
      "item": [
        {
          "name": "1.1 Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@looppay.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as default seeded Admin and returns a JWT token."
          }
        },
        {
          "name": "1.2 Signup Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Alice@1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "signup"]
            },
            "description": "Registers a new customer. Password requires >8 chars, 1 uppercase, 1 lowercase, 1 special char."
          }
        },
        {
          "name": "1.3 Login as Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Alice@1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as the created Customer."
          }
        },
        {
          "name": "1.4 Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/forgot-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Sends reset link (check console logs for the UUID token)."
          }
        },
        {
          "name": "1.5 Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_CONSOLE_HERE\",\n  \"newPassword\": \"AliceNew@1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/reset-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Resets user password with the token received in forgot-password."
          }
        }
      ]
    },
    {
      "name": "2. Admin Only APIs",
      "item": [
        {
          "name": "2.1 Create Staff User (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "PASTE_ADMIN_JWT_TOKEN_HERE",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Staff\",\n  \"email\": \"bob.staff@looppay.com\",\n  \"password\": \"Staff@1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/admin/users/staff",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "admin", "users", "staff"]
            },
            "description": "Requires ADMIN JWT Bearer token in Authorization header."
          }
        }
      ]
    }
  ]
}

