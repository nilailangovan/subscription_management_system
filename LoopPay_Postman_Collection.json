              "port": "8080",
              "path": ["api", "plans", "1", "close"]
            },
            "description": "Sets plan status to CLOSED. Rejects with 400 if closable=false."
          }
        },
        {
          "name": "6.2 Pause Plan",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ADMIN_JWT_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "url": {
              "raw": "http://localhost:8080/api/plans/1/pause",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "plans", "1", "pause"]
            },
            "description": "Sets plan status to PAUSED. Rejects with 400 if pausable=false."
          }
        },
        {
          "name": "6.3 Resume Plan",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ADMIN_JWT_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "url": {
              "raw": "http://localhost:8080/api/plans/1/resume",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "plans", "1", "resume"]
            },
            "description": "Sets status to ACTIVE. Rejects with 400 if status is not PAUSED."
          }
        },
        {
          "name": "6.4 Renew Plan",
          "request": {
            "auth": {
